region              = "us-west-2"
aws_profile         = "your-profile"
# aws_account_id    = "123456789012"
environment         = "personal"
# Optional: omit domain_name to use the CloudFront hostname.
# domain_name       = "pantridge.example.com"
# For Namecheap/external DNS, leave route53_zone_id unset.
# For Route53-managed DNS, set the existing public zone:
# route53_zone_id   = "Z0123456789EXAMPLE"
# Optional GitHub deployment (existing account OIDC provider required).
# github_repository = "owner/repository"
# Set the exact sub_claim_prefix from the repository OIDC API:
# github_subject_prefix = "repo:owner@123/repository@456"
