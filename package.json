{
  "name": "pantridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "structure": "node scripts/check-structure.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm structure && pnpm format:check && pnpm test && pnpm build",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/client-ssm": "3.1128.0",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "idb": "8.0.3",
    "lucide-react": "1.42.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workbox-window": "7.4.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/aws-lambda": "8.10.163",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
